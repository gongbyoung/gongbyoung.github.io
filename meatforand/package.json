{
  "name": "meatpoan-app",
  "private": true,
  "version": "1.0.0",
  "description": "미트포앤 발주 및 재고 관리 안드로이드 앱 (Vite + Capacitor)",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "cap:add:android": "node ./node_modules/@capacitor/cli/bin/capacitor add android",
    "cap:sync": "node ./node_modules/vite/bin/vite.js build && node ./node_modules/@capacitor/cli/bin/capacitor sync android",
    "cap:open": "node ./node_modules/@capacitor/cli/bin/capacitor open android",
    "cap:run": "node ./node_modules/vite/bin/vite.js build && node ./node_modules/@capacitor/cli/bin/capacitor run android",
    "apk:build": "node ./build-apk.mjs",
    "apk:serve": "node ./phone-install-server.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "leaflet": "^1.9.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "vite": "^6.0.0"
  }
}
